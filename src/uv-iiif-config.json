{
  "options": {
    "dropEnabled": true,
    "footerPanelEnabled": true,
    "headerPanelEnabled": true,
    "leftPanelEnabled": true,
    "searchLeftPanelEnabled": true,
    "limitLocales": false,
    "overrideFullScreen": false,
    "pagingEnabled": true,
    "preferMediaElementExtension": false,
    "rightPanelEnabled": true,
    "textRightPanelEnabled": true,
    "clickToZoomEnabled": false,
    "truncateThumbnailLabels": false,
    "searchWithinEnabled": false,
    "useRiksarkivetLegacyURLs": false,
    "saveUserSettings": true,
    "zoomToSearchResultEnabled": false,
    "animationDuration": 250,
    "thumbsEnabled": false
  },
  "modules": {
    "avCenterPanel": {
      "options": {
        "mostSpecificRequiredStatement": true
      }
    },
    "downloadDialogue": {
      "options": {
        "selectionEnabled": true,
        "downloadOcrEnabled": true,
        "downloadUrls": {
          "currentAsXml": "https://lbiiif-acc.riksarkivet.se/download/current/alto/{0}?format=xml&imageid={1}",
          "currentAsZippedXml": "https://lbiiif-acc.riksarkivet.se/download/current/alto/{0}?format=zip&imageid={1}",
          "currentAsText": "https://lbiiif-acc.riksarkivet.se/download/current/text/{0}?format=text&imageid={1}",
          "currentAsZippedText": "https://lbiiif-acc.riksarkivet.se/download/current/text/{0}?format=zip&imageid={1}",
          "volumeAsZippedXml": "https://lbiiif-acc.riksarkivet.se/download/volume/alto/{0}",
          "volumeAsZippedText": "https://lbiiif-acc.riksarkivet.se/download/volume/text/{0}"
        }
      }
    },
    "settingsDialogue": {
      "options": {
        "showClickToZoomSetting": false
      }
    },
    "headerPanel": {
      "options": {
        "localeToggleEnabled": false
      }
    },
    "pagingHeaderPanel": {
      "options": {
        "pagingToggleEnabled": true,
        "imageSelectionBoxEnabled": true,
        "autoCompleteBoxEnabled": false,
        "modeOptionsEnabled": false,
        "galleryButtonEnabled": false,
        "showLogo": true
      }
    },
    "openSeadragonCenterPanel": {
      "options": {
        "autoHideControls": false,
        "showHomeControl": true,
        "showAdjustImageControl": true,
        "preserveViewportForQuery": true,
        "zoomFactor": 1.1
      }
    },
    "mediaElementCenterPanel": {
      "options": {
        "autoPlayOnSetTarget": false
      }
    },
    "footerPanel": {
      "options": {
        "downloadEnabled": true
      }
    },
    "textRightPanel": {
      "options": {
        "panelExpandedWidth": 270,
        "copyToClipboardEnabled": true,
        "panelOpen": true
      }
    },
    "searchLeftPanel": {
      "options": {
        "panelExpandedWidth": 270
      }
    },
    "moreInfoRightPanel": {
      "options": {
        "copyToClipboardEnabled": true
      }
    },
    "contentLeftPanel": {
      "options": {
        "defaultToTreeEnabled": false
      }
    },
    "searchFooterPanel": {
      "options": {
        "shareEnabled": false,
        "printEnabled": true
      }
    },
    "mobileFooterPanel": {
      "options": {
        "shareEnabled": false,
        "printEnabled": true
      }
    },
    "shareDialogue": {
      "options": {
        "embedPath": "/uv.html",
        "embedHost": null,
        "embedPort": null,
        "embedTemplate": "<iframe src=\"{0}\" width=\"{1}\" height=\"{2}\" allowfullscreen frameborder=\"0\" title=\"{3}\"></iframe>"
      }
    }
  }
}